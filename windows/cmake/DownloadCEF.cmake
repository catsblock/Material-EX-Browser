function(download_cef platform version_pattern destination out_root)
  set(index_file "${destination}/cef-index.json")
  file(MAKE_DIRECTORY "${destination}")
  if(NOT EXISTS "${index_file}")
    file(DOWNLOAD "https://cef-builds.spotifycdn.com/index.json" "${index_file}" STATUS dl_status TLS_VERIFY ON)
    list(GET dl_status 0 dl_code)
    if(NOT dl_code EQUAL 0)
      message(FATAL_ERROR "Unable to download the CEF build index: ${dl_status}")
    endif()
  endif()
  file(READ "${index_file}" index_json)
  string(JSON versions_json GET "${index_json}" "${platform}" "versions")
  string(JSON count LENGTH "${versions_json}")
  set(chosen_name "")
  set(chosen_sha "")
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON channel GET "${versions_json}" ${i} "channel")
    if(NOT channel STREQUAL "stable")
      continue()
    endif()
    string(JSON files_json GET "${versions_json}" ${i} "files")
    string(JSON file_count LENGTH "${files_json}")
    math(EXPR file_last "${file_count} - 1")
    foreach(j RANGE 0 ${file_last})
      string(JSON file_type GET "${files_json}" ${j} "type")
      if(file_type STREQUAL "minimal")
        string(JSON chosen_name GET "${files_json}" ${j} "name")
        string(JSON chosen_sha GET "${files_json}" ${j} "sha1")
        break()
      endif()
    endforeach()
    if(chosen_name)
      break()
    endif()
  endforeach()
  if(NOT chosen_name)
    message(FATAL_ERROR "No stable minimal CEF build found for ${platform}")
  endif()
  set(archive "${destination}/${chosen_name}")
  if(NOT EXISTS "${archive}")
    message(STATUS "Downloading ${chosen_name}")
    file(DOWNLOAD "https://cef-builds.spotifycdn.com/${chosen_name}" "${archive}" EXPECTED_HASH SHA1=${chosen_sha}
         SHOW_PROGRESS TLS_VERIFY ON)
  endif()
  string(REGEX REPLACE "\\.tar\\.bz2$" "" folder "${chosen_name}")
  if(NOT EXISTS "${destination}/${folder}/cmake")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
  endif()
  set(${out_root} "${destination}/${folder}" PARENT_SCOPE)
endfunction()
